+// The same personalized binary is installed under two filenames. Only the
+// exact normal basename requests normal runtime policy; renamed copies stay
+// Debug. UEFI file paths are UCS-2 and FAT filenames are case-insensitive.
+fn configured_normal_path(path: &[u16]) -> bool {
+    let path = path.strip_suffix(&[0]).unwrap_or(path);
+    let basename = path.rsplit(|c| *c == u16::from(b'\\') || *c == u16::from(b'/'))
+        .next().unwrap_or(&[]);
+    let expected = b"normalx64.efi";
+    basename.len() == expected.len() && basename.iter().zip(expected).all(|(a, b)| {
+        *a == u16::from(*b) || *a == u16::from(b.to_ascii_uppercase())
+    })
 }
 
