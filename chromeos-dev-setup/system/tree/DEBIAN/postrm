#!/bin/sh
set -e

# Reload systemd and udev after removal, but never delete /var/lib/tmp: the
# subvolume is user data and is harmless when the package is not installed.
reload_services() {
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
    fi
    if command -v udevadm >/dev/null 2>&1 && udevadm control --ping >/dev/null 2>&1; then
        udevadm control --reload-rules || true
        udevadm trigger --subsystem-match=usb || true
    fi
}

case "$1" in
    remove|purge)
        reload_services
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
