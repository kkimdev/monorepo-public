#!/bin/sh
set -e

# CROS_DEV_SYSTEM_SKIP_TMP=1 skips ONLY the btrfs /tmp subvolume step below.
# The container test uses it because containers cannot manage btrfs
# subvolumes; the service reloads still run.
#
# The rest of this script is idempotent so reinstalling a new package version
# (or configuring twice) is safe.

configure_disk_backed_tmp() {
    tmp_subvolume_path=/var/lib/tmp
    tmp_mem_total_kib=
    tmp_quota_bytes=
    tmp_quota_gib=
    tmp_subvolume_id=

    tmp_mem_total_kib=$(awk '$1 == "MemTotal:" { print $2; exit }' /proc/meminfo)
    if [ -z "$tmp_mem_total_kib" ] || [ "$tmp_mem_total_kib" -le 0 ]; then
        echo "ERROR: could not determine MemTotal for the /tmp quota." >&2
        return 1
    fi
    tmp_quota_bytes=$((tmp_mem_total_kib * 1024 / 2))
    tmp_quota_gib=$(awk -v bytes="$tmp_quota_bytes" \
        'BEGIN { printf "%.1f GiB", bytes / 1024 / 1024 / 1024 }')

    if [ "$(findmnt -no FSTYPE -T /)" != btrfs ]; then
        echo "ERROR: the root filesystem is not btrfs; refusing to configure a btrfs /tmp subvolume." >&2
        return 1
    fi
    if ! command -v btrfs >/dev/null 2>&1; then
        echo "ERROR: btrfs-progs is unavailable." >&2
        return 1
    fi

    install -d -m 0755 /var/lib
    if ! btrfs subvolume show "$tmp_subvolume_path" >/dev/null 2>&1; then
        if [ -e "$tmp_subvolume_path" ]; then
            echo "ERROR: $tmp_subvolume_path exists but is not a btrfs subvolume; refusing to replace it." >&2
            return 1
        fi
        btrfs subvolume create "$tmp_subvolume_path"
    fi
    chmod 1777 "$tmp_subvolume_path"

    # qgroup enable reports an error when quotas are already enabled; the
    # limit command below is the authoritative success check.  Debian's
    # btrfs-progs requires the explicit level-0 qgroup ID.
    btrfs quota enable / >/dev/null 2>&1 || true
    tmp_subvolume_id=$(btrfs subvolume show "$tmp_subvolume_path" \
        | awk '$1 == "Subvolume" && $2 == "ID:" { print $3; exit }')
    if [ -z "$tmp_subvolume_id" ]; then
        echo "ERROR: could not determine the btrfs subvolume ID for $tmp_subvolume_path." >&2
        return 1
    fi
    btrfs qgroup limit "$tmp_quota_bytes" "0/$tmp_subvolume_id" "$tmp_subvolume_path"

    # Disable data CoW for this disposable build area.
    chattr +C "$tmp_subvolume_path"

    if [ "$(findmnt -no SOURCE -T /tmp 2>/dev/null || true)" = tmpfs ]; then
        echo "Configured disk-backed /tmp for the next reboot (current tmpfs was not unmounted)."
    fi
    echo "Configured /tmp quota: $tmp_quota_gib ($tmp_quota_bytes bytes)."
}

reload_services() {
    # Never fail the package transaction because a service is not running.
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
    fi
    if command -v udevadm >/dev/null 2>&1 && udevadm control --ping >/dev/null 2>&1; then
        udevadm control --reload-rules || true
        udevadm trigger --subsystem-match=usb || true
    fi
}

case "$1" in
    configure)
        if [ "${CROS_DEV_SYSTEM_SKIP_TMP:-0}" = 1 ]; then
            echo "Skipping disk-backed /tmp configuration (CROS_DEV_SYSTEM_SKIP_TMP=1)."
        else
            configure_disk_backed_tmp
        fi
        reload_services
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
